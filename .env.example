# Base URL of the erxes instance that serves /api/graphql and /api/auth/*
ERXES_URL=https://erxes.io

# Content Hub account (the user needs the cms, ams, admin or super_admin role)
ERXES_EMAIL=
ERXES_PASSWORD=

# Optional: reuse an existing NextAuth session cookie instead of
# email/password login. Value is sent verbatim as the Cookie header.
# ERXES_SESSION_COOKIE=
